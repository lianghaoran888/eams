<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.AssetCategoryMapper">

<!--    分页查询-->
    <select id="pageQuery" resultType="com.sky.entity.AssetCategory">
        select * from asset_category
        <where>
            <if test="name != null and name != ''">
                name like concat('%',#{name},'%')
            </if>
            <if test="status != null">
                and status = #{status}
            </if>
        </where>
        order by sort asc , create_time desc
    </select>

<!--    根据 id 修改分类 / 启用、禁用分类状态 -->
    <update id="update" parameterType="com.sky.entity.AssetCategory">
        update asset_category
        <set>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="sort != null">
                sort = #{sort},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="updateUser != null">
                update_user = #{updateUser}
            </if>
        </set>
        where id = #{id}
    </update>

<!--    查询启用状态的全部分类 -->
    <select id="list" resultType="com.sky.entity.AssetCategory">
        select * from asset_category where status = 1
        order by sort asc, create_time desc
    </select>
</mapper>